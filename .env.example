MONGODB_URI=mongodb://127.0.0.1:27017/shahzaibroyalacademy
MONGODB_DB=shahzaibroyalacademy
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Optional; defaults to the email configured in src/config/academy.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-with-a-strong-admin-password
INSTRUCTOR_PASSWORD=replace-with-a-strong-instructor-password
STUDENT_PASSWORD=replace-with-a-strong-student-password
PARENT_PASSWORD=replace-with-a-strong-parent-password
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-nextauth-secret
# Use console locally; set to smtp in production to send real email.
EMAIL_PROVIDER=console
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email-user
EMAIL_PASS=replace-with-email-password
EMAIL_FROM="Shahzaib Royal Academy <no-reply@example.com>"
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/example
NEXT_PUBLIC_X_URL=https://x.com/example
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/example
# Public media store token (gallery, faculty, and program images).
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
# Store ID for the dedicated private store; the helper verifies token/store matches.
BLOB_PRIVATE_STORE_ID=replace-with-private-store-id
# Dedicated PRIVATE Vercel Blob token for admission documents and payment proofs.
BLOB_PRIVATE_READ_WRITE_TOKEN=replace-with-private-vercel-blob-token
# Optional aliases; public tokens must belong to a different store than the private store.
BLOB_PRIVATE=
BLOB_PUBLIC_READ_WRITE_TOKEN=
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional DNS override for local scripts only; comma-separated server IPs.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Copy to .env.production.local for the production seed. This file is gitignored.
# Set MONGODB_URI, MONGODB_DB, ADMIN_EMAIL, and ADMIN_PASSWORD there; do not commit it.
